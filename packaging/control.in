Package: node-desk
Version: @VERSION@
Section: net
Priority: optional
Architecture: all
Depends: python3, python3-tk, python3-keyring, python3-secretstorage, openssh-client, x-terminal-emulator
Recommends: tailscale, gnome-keyring
